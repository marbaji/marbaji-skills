#!/bin/sh
# Scans every commit about to be pushed for personal data; see tests/personal_data_scan.py.
# Enable once per clone:  git config core.hooksPath .githooks
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
git rev-parse --verify --quiet "origin/main^{commit}" >/dev/null || {
  echo "pre-push: origin/main is not fetched, so the outgoing commits cannot be worked out. Run: git fetch origin" >&2
  exit 1
}
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a remote branch pushes no commits
  # Everything being pushed that the public main branch does not already hold.
  range="origin/main..$local_sha"
  count=$(git rev-list --count "$range") || exit 1
  [ "$count" -gt 0 ] || continue   # nothing new in this ref
  python3 "$root/tests/personal_data_scan.py" --commits "$range" || status=1
done
[ "$status" -eq 0 ] || echo "pre-push: personal data found, nothing was pushed." >&2
exit $status
